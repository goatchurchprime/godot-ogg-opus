[configuration]
entry_symbol = "ogg_opus_library_init"
compatibility_minimum = "4.5"
reloadable = true

[icons]
AudioStreamOggOpus = "res://addons/ogg_opus/icons/audio_stream_ogg_opus.svg"

[libraries]
macos = "res://addons/ogg_opus/bin/libogg_opus.macos.template_debug.universal.framework"
macos.template_release = "res://addons/ogg_opus/bin/libogg_opus.macos.template_release.universal.framework"

windows.debug.x86_64 = "res://addons/ogg_opus/bin/libogg_opus.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/ogg_opus/bin/libogg_opus.windows.template_release.x86_64.dll"

linux.debug.x86_64 = "res://addons/ogg_opus/bin/libogg_opus.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/ogg_opus/bin/libogg_opus.linux.template_release.x86_64.so"

android.debug.arm32 = "res://addons/ogg_opus/bin/libogg_opus.android.template_debug.arm32.so"
android.debug.arm64 = "res://addons/ogg_opus/bin/libogg_opus.android.template_debug.arm64.so"
android.debug.x86_32 = "res://addons/ogg_opus/bin/libogg_opus.android.template_debug.x86_32.so"
android.debug.x86_64 = "res://addons/ogg_opus/bin/libogg_opus.android.template_debug.x86_64.so"
android.release.arm32 = "res://addons/ogg_opus/bin/libogg_opus.android.template_release.arm32.so"
android.release.arm64 = "res://addons/ogg_opus/bin/libogg_opus.android.template_release.arm64.so"
android.release.x86_32 = "res://addons/ogg_opus/bin/libogg_opus.android.template_release.x86_32.so"
android.release.x86_64 = "res://addons/ogg_opus/bin/libogg_opus.android.template_release.x86_64.so"

web.debug.wasm32.nothreads = "res://addons/ogg_opus/bin/libogg_opus.web.template_debug.wasm32.wasm"
web.debug.wasm32 = "res://addons/ogg_opus/bin/libogg_opus.web.template_debug.wasm32.threads.wasm"
web.release.wasm32.nothreads = "res://addons/ogg_opus/bin/libogg_opus.web.template_release.wasm32.wasm"
web.release.wasm32 = "res://addons/ogg_opus/bin/libogg_opus.web.template_release.wasm32.threads.wasm"

ios.debug.arm64 = "res://addons/ogg_opus/bin/libogg_opus.ios.template_debug.arm64.dylib"
ios.release.arm64 = "res://addons/ogg_opus/bin/libogg_opus.ios.template_release.arm64.dylib"
